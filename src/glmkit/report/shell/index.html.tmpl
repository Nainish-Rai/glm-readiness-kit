<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="assets/tokens.css">
<link rel="stylesheet" href="assets/components.css">
<!--
  Generated by `glmkit report build` from src/glmkit/report/shell/index.html.tmpl (derived from the
  Observatory UI layout.html, MIT). Tabs come from page modules in src/glmkit/report/pages/. Data lives in
  data/<page>.js so the page opens from disk (file://). Do not edit the generated file.
-->
<style>
{{STYLE}}
</style>
</head>
<body>

<!-- region: header -->
<header class="top">
  <div class="top-in">
    <div class="brand"><span class="brand-mark" aria-hidden="true"></span>GLM readiness kit</div>
    <span class="window" id="window"></span>
    <span class="spacer"></span>
  </div>
  <nav id="tabs"></nav>
</header>
<!-- /region: header -->

<main class="main">
  <!-- region: kpis -->
  <section id="kpis" aria-label="Summary"></section>
  <!-- /region: kpis -->

  <!-- region: views (one per page module) -->
{{VIEWS}}
  <!-- /region: views -->

  <footer class="foot" id="foot"></footer>
</main>

<!-- region: drawer (shared by every tab through GLMKit.openDrawer) -->
<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drTitle" aria-hidden="true">
  <div class="dr-h">
    <div class="dr-title"><span class="dr-lead"></span><h3 id="drTitle"></h3><span class="dr-tag"></span>
      <button type="button" class="chip dr-close" aria-label="Close details">Close <span class="mono t-faint" aria-hidden="true">Esc</span></button></div>
    <div id="drStrip"></div>
    <div id="drStats"></div>
  </div>
  <div class="dr-body">
    <div class="dr-main" id="drMain" tabindex="-1"></div>
    <div class="detail" id="drDetail"></div>
  </div>
</aside>
<!-- /region: drawer -->

<script src="assets/components.iife.js"></script>
{{DATA_SCRIPTS}}
<script>
{{SCRIPT}}
</script>
</body>
</html>
