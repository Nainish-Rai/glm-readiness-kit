{
 "name": "canaries",
 "version": 1,
 "description": "Capability canaries: a BFCL-style tool-call slice, a small math slice and long-context needles (percent-of-reference with a 95% CI).",
 "filler": [
  "The committee reviewed the quarterly logistics summary and noted no deviations from the agreed schedule.",
  "Warehouse staff rotated shifts according to the posted roster, and the inventory counts matched the ledger.",
  "A routine inspection of the loading dock found the equipment in good working order.",
  "Customer correspondence was triaged by region, and standard replies were sent within the usual window.",
  "The maintenance log lists a lubricant change, a belt replacement and a calibration of the sorting scanner.",
  "Meeting notes record that the supplier agreed to deliver the remaining pallets before the end of the month.",
  "Weather delays at the northern depot were absorbed by rerouting two trucks through the central hub.",
  "The training session covered forklift safety, labeling rules and the revised returns procedure."
 ],
 "bfcl": [
  {
   "id": "bfcl-01",
   "family": "bfcl",
   "prompt": "What is the weather in Paris in celsius?",
   "tools": [
    {
     "name": "get_weather",
     "description": "Get the current weather for a city.",
     "parameters": {
      "type": "object",
      "properties": {
       "city": {
        "type": "string"
       },
       "unit": {
        "type": "string",
        "enum": [
         "celsius",
         "fahrenheit"
        ]
       }
      },
      "required": [
       "city"
      ]
     }
    },
    {
     "name": "get_stock_price",
     "description": "Get the latest stock price for a ticker.",
     "parameters": {
      "type": "object",
      "properties": {
       "ticker": {
        "type": "string"
       }
      },
      "required": [
       "ticker"
      ]
     }
    }
   ],
   "expected_calls": [
    {
     "name": "get_weather",
     "arguments": {
      "city": "Paris",
      "unit": "celsius"
     }
    }
   ]
  },
